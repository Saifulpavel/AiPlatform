{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "AiPlatform",
    "Audience": "AiPlatform.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Llm": {
    "DefaultProvider": "gemini",
    "Providers": {
      "gemini":     { "Type": "gemini", "Model": "gemini-2.5-flash-lite" },
      "groq":       { "Type": "openai", "BaseUrl": "https://api.groq.com/openai/v1/chat/completions", "Model": "llama-3.3-70b-versatile" },
      "cerebras":   { "Type": "openai", "BaseUrl": "https://api.cerebras.ai/v1/chat/completions", "Model": "llama3.1-8b" },
      "openrouter": { "Type": "openai", "BaseUrl": "https://openrouter.ai/api/v1/chat/completions", "Model": "meta-llama/llama-3.3-70b-instruct:free" },
      "mistral":    { "Type": "openai", "BaseUrl": "https://api.mistral.ai/v1/chat/completions", "Model": "mistral-small-latest" },
      "github":     { "Type": "openai", "BaseUrl": "https://models.github.ai/inference/chat/completions", "Model": "openai/gpt-4o-mini" }
    },
    "Embedding": { "Model": "gemini-embedding-001" },
    "Routing": {
      "Enabled": true,
      "CheapProvider": "gemini",
      "StrongProvider": "groq",
      "WordThreshold": 30,
      "ComplexKeywords": [ "explain", "analyze", "compare", "why", "step by step", "reasoning", "prove", "design", "architecture", "ব্যাখ্যা", "বিশ্লেষণ", "তুলনা", "কেন" ]
    },
    "Pricing": {
      "gemini-2.5-flash-lite":    { "InputPerMillion": 0.10, "OutputPerMillion": 0.40 },
      "llama-3.3-70b-versatile":  { "InputPerMillion": 0.59, "OutputPerMillion": 0.79 },
      "mistral-small-latest":     { "InputPerMillion": 0.20, "OutputPerMillion": 0.60 }
    }
  },
  "SemanticCache": {
    "Enabled": true,
    "SimilarityThreshold": 0.95,
    "Collection": "semantic_cache"
  },
  "Qdrant": {
    "Url": "http://localhost:6333",
    "Collection": "aiplatform_rag"
  },
  "AllowedHosts": "*"
}
