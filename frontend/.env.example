# কপি করে `.env` বানাও।
VITE_API_BASE_URL=http://localhost:5076

# Google Sign-In (ঐচ্ছিক) — Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web)।
# backend-এও একই ClientId লাগবে: Authentication__Google__ClientId (user-secrets/env)।
# খালি থাকলে Google button placeholder দেখায়।
VITE_GOOGLE_CLIENT_ID=
