# .env.example — কপি করে `.env` বানাও, আসল value ভরো। `.env` কখনো commit না।
# .NET secrets local dev-এ user-secrets দিয়ে দাও; .env মূলত docker-compose (Phase 5) + frontend (Phase 4)।
# প্রতিটা phase-এ নতুন লাইন যোগ হবে — এখন শুধু placeholder।

# --- Frontend (Phase 4) ---
VITE_API_BASE_URL=http://localhost:5076

# --- SQL Server (Phase 1) — docker-compose reads this ---
SA_PASSWORD=Your_strong_Pass123!

# --- JWT signing key (Phase 5 compose api containers) ---
JWT_SECRET=change-me-to-a-long-random-secret

# --- Redis (Phase 1) ---
# REDIS_CONNECTION=localhost:6379

# --- Qdrant (Phase 3) ---
# QDRANT_URL=http://localhost:6333

# --- LLM providers (Phase 2) — কোডে নয়, secrets/env এ ---
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
